{
  "manifest_version": 3,
  "name": "Picky",
  "version": "0.5.1",
  "description": "The internet, but picky. Filter any feed with rules you write in plain words.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Picky",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["adapters.js", "ads.js", "cleanui.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["ads.js", "frame.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.youtube.com/*", "https://*.instagram.com/*"],
      "js": ["prefetch.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
